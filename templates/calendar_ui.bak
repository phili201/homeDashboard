{% extends "base.html" %}
{% block title %}Kalender{% endblock %}

{% block content %}
<h1>Kalender – nächste 7 Tage</h1>

<div class="grid">
    {% for e in events %}
    <div class="card">
        <h3>{{ e.summary or "Ohne Titel" }}</h3>
        {% if e.start.dateTime %}
            <p>Start: {{ e.start.dateTime }}</p>
        {% else %}
            <p>Start: {{ e.start.date }}</p>
        {% endif %}
    </div>
    {% endfor %}
</div>
{% endblock %}
